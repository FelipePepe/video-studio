# Copy to .env and adjust. Placeholders only; never commit real secrets.

# Where the web service is published (WEB_BIND=127.0.0.1 restricts it to the host).
WEB_BIND=0.0.0.0
WEB_PORT=20014

# Host directory bind-mounted at /app/backend/data (SQLite DB, jobs, cache, logs).
DATA_DIR=./data

# Examples from the homelab. They can also be changed from the Settings modal;
# values saved there are persisted in the DB and override these env defaults.
COMFY_HOST=http://192.168.1.60:8188
OLLAMA_HOST=http://192.168.1.60:11434
PIPER_HOST=tcp://192.168.1.60:10200

OLLAMA_MODEL=gemma4:26b
OLLAMA_NUM_CTX=
OLLAMA_KEEP_ALIVE=
# Ollama chat timeout in ms (empty = 300000) and /api/tags timeout in ms (empty = 5000).
OLLAMA_TIMEOUT_MS=
OLLAMA_TAGS_TIMEOUT_MS=
# Max concurrent POST /api/pipeline/draft generations; extra requests get 429 (empty = 2).
DRAFT_MAX_CONCURRENCY=
# ffmpeg watchdog in ms: a stuck ffmpeg is killed after this long (empty = 1800000).
FFMPEG_TIMEOUT_MS=
MUSIC_DIR=
LOG_LEVEL=info
RETENTION_MIN_AGE_DAYS=
RETENTION_KEEP_RECENT=
